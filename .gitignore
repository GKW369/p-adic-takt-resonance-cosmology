# OS & system-specific cache files (Ubuntu / Linux)
*~
.*.swp
.*.swo
.DS_Store
.directory

# Text editor & office backup files (OpenOffice / LibreOffice / Vim)
.~lock.*.odt#
.~lock.*.doc#
.~lock.*.csv#

# Python bytecode & runtime caches (enforces clean Z-Clock routing)
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# LaTeX documentation auxiliary files
*.aux
*.log
*.toc
*.out
*.synctex.gz
*.fdb_latexmk
*.fdb_latexmk
*.fls
*.blg
*.bbl

# Temporary render frames & data streams of the pTRC engines
# Prevents transient frame dumps from cluttering the repository
ptrc_temp_frames/
ptrc_complete_context_bundle.txt

# Local output media (generated directly on target systems)
ptrc_4k_genesis.ppm
ptrc_3d_stereoscopic_retina.mp4

# Local benchmark & image artifacts
ptrc_graphics_benchmark_report.json
*.ppm
